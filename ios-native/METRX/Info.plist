<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>uz</string>
	<!-- the permission questions are in uz, ru and en (uz.lproj, ru.lproj, en.lproj InfoPlist.strings); uz Cyrillic reads uz -->
	<key>CFBundleLocalizations</key>
	<array><string>uz</string><string>ru</string><string>en</string></array>
	<key>CFBundleDisplayName</key><string>METRX</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>METRX</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UIApplicationSceneManifest</key>
	<dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
	<!-- the native launch screen is the animation's first colour, so nothing flashes before it -->
	<key>UILaunchScreen</key>
	<dict><key>UIColorName</key><string>LaunchBG</string></dict>
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationPortrait</string></array>
	<key>UIStatusBarStyle</key><string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key><true/>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
	<!-- asked when the builder taps "Joylashuvni aniqlash" on a new order or project; once allowed, that form also reads the
	     place quietly while it is open (UX/OrderLocation.swift warm()), so the tap is quick; GPS works without internet.
	     The texts the phone shows are in the .lproj InfoPlist.strings; these are the fallback. -->
	<key>NSLocationWhenInUseUsageDescription</key><string>Buyurtma yoki loyiha joyini saqlab, keyin xaritada yo‘l topish uchun. Joylashuv faqat yangi buyurtma yoki loyiha sahifasi ochiq turganda olinadi va telefonda qoladi. / METRX saves the place of an order or project so you can find the way there later. It reads your location only while the new order or project form is open, and it stays on the phone.</string>
	<!-- asked once on a tap when "Precise Location" is off for METRX (Gps in UX/OrderLocation.swift) -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict><key>OrderPlace</key><string>Mijoz uyining aniq joyini saqlash uchun aniq joylashuv kerak — taxminiy joy bir necha km xato bo‘ladi. / Precise location saves the exact place of the client’s home; an approximate one can be kilometres off.</string></dict>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>yandexmaps</string>
		<string>yandexnavi</string>
		<string>comgooglemaps</string>
	</array>
	<key>NSCameraUsageDescription</key><string>METRX takes photos of walls and openings to draw dimensions on them. / Devor va ochiq joylarni suratga olib, ustiga o‘lcham chizish uchun.</string>
	<!-- asked the first time the builder holds the mic button under a size field (UX/VoiceUI.swift); offline recognition -->
	<key>NSMicrophoneUsageDescription</key><string>O‘lchamni ovoz bilan aytish uchun mikrofon kerak: tugmani bosib turib gapirasiz. Ovoz telefonning o‘zida taniladi va hech qayerga yuborilmaydi. / The microphone hears a size you say while you hold the button; the voice is recognised on the phone and never sent anywhere.</string>
	<!-- asked when the builder opens the laser radar ("Qidirish") or a remembered laser is tried; no background modes -->
	<key>NSBluetoothAlwaysUsageDescription</key><string>METRX lazer o‘lchagichdan masofani olish uchun Bluetooth’dan foydalanadi. / METRX uses Bluetooth to read distances from your laser meter.</string>
	<!-- the share sheet's "Save Image" for a marked-up photo (Markup/MarkupScreen.swift shareShot) -->
	<key>NSPhotoLibraryAddUsageDescription</key><string>O‘lcham chizilgan suratni galereyangizga saqlash uchun. / METRX saves the photo with its dimensions to your library when you choose Save Image.</string>
	<key>NSPhotoLibraryUsageDescription</key><string>METRX opens a photo from your library to draw dimensions on it. / Galereyadagi suratni ochib, ustiga o‘lcham chizish uchun.</string>
	<key>UIAppFonts</key>
	<array>
		<string>PlusJakartaSans-Regular.ttf</string><string>PlusJakartaSans-Medium.ttf</string><string>PlusJakartaSans-SemiBold.ttf</string>
		<string>PlusJakartaSans-Bold.ttf</string><string>PlusJakartaSans-ExtraBold.ttf</string>
		<string>Manrope-Regular.ttf</string><string>Manrope-Medium.ttf</string><string>Manrope-SemiBold.ttf</string>
		<string>Manrope-Bold.ttf</string><string>Manrope-ExtraBold.ttf</string>
		<string>ibm_plex_condensed_regular.ttf</string><string>ibm_plex_condensed_medium.ttf</string>
		<string>ibm_plex_condensed_semibold.ttf</string><string>ibm_plex_condensed_bold.ttf</string>
		<string>ibm_plex_mono_regular.ttf</string><string>ibm_plex_mono_medium.ttf</string>
		<string>ibm_plex_mono_semibold.ttf</string><string>ibm_plex_mono_bold.ttf</string>
	</array>
</dict>
</plist>
