<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  METRX's privacy manifest. The app has no accounts, no analytics, no ads and no servers: projects, photos, readings and
  settings stay on the phone, so nothing is collected and nothing tracks. The required-reason APIs it calls:
  - UserDefaults (Core/Settings.swift, Data/Store.swift): the app's own settings, read and written by this app only (CA92.1).
  - ProcessInfo.systemUptime (Laser/LaserLog.swift): times between the laser's Bluetooth events inside the app (35F9.1).
  - File dates and sizes (Furniture/CardCache.swift contentModificationDate, Furniture/Client3DShare.swift
    attributesOfItem): of files this app made in its own container, never shown off the phone (C617.1).
  It reads no free disk space.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
